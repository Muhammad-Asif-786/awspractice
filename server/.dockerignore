# ================================
# Node.js / Server .dockerignore
# ================================

# Dependencies (install hoti hain build k waqt)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output (Docker mein fresh build hoga)
dist/

# Environment variables (sensitive data - kabhi copy mat karo)
.env
.env.*
!.env.example

# Git files
.git/
.gitignore

# Docker files (zaroorat nahi container k andar)
Dockerfile
.dockerignore

# Logs
logs/
*.log

# OS generated files
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
